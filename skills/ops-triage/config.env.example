# Owner-controlled configuration for collect-evidence.sh. Copy to config.env
# (gitignored). These values are config, never derived from alert text.
OPS_TRIAGE_KUBE_CONTEXT=
OPS_TRIAGE_PROM_NAMESPACE=monitoring
OPS_TRIAGE_PROM_SERVICE=monitoring-prometheus
# Unset profile = AWS evidence skipped. Use a read-only profile.
OPS_TRIAGE_AWS_PROFILE=
OPS_TRIAGE_AWS_REGION=us-west-2
